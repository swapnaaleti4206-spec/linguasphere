# ==========================================
# English AI Learning Platform Environment Config
# ==========================================

# Application Port and Host
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# JWT Secret Key for token signing
JWT_SECRET=super-secret-jwt-key-change-in-production-2026-english-ai
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days

# Max Allowed Users (defaults to 2 from allowed_users.json if unset)
MAX_ALLOWED_USERS=2

# Path to allowed users config JSON file
ALLOWED_USERS_FILE=./config/allowed_users.json

# Optional External AI API Keys (fallback to built-in Intelligent Local AI Engine if empty)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional SMTP Settings for real email OTP delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@english-ai.platform
